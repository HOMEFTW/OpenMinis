  <string name="network_restore_direct">Restore Direct Connections</string>
  <string name="network_restore_direct_footer">Turns Tailscale and every proxy route off at once, without a restart: all of Minis connects as if nothing here were set. Your settings are kept.</string>
  <string name="network_paused_title">Network settings are off</string>
  <string name="network_paused_message">Every connection is direct. Turn them back on to use Tailscale and your proxies again.</string>
