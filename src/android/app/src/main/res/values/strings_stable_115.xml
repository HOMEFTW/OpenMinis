  <string name="network_proxies">Proxies</string>
  <string name="network_proxies_footer">HTTP, HTTPS or SOCKS5 proxies. Passwords are encrypted with the Android Keystore.</string>
  <string name="network_add_proxy">Add Proxy</string>
  <string name="network_edit_proxy">Edit Proxy</string>
  <string name="network_used_by">Used By</string>
  <string name="network_scope_shell">Shell</string>
  <string name="network_scope_browser">Browser</string>
  <string name="network_scope_mcp">MCP</string>
  <string name="network_scope_backup">Backup</string>
  <string name="network_used_by_footer">Shell: a change reaches open shells from their next command; a program already running keeps the settings it started with. Backup: WebDAV, S3, SFTP and FTP servers follow this route; SMB servers always connect directly. MCP: HTTP MCP servers and MCP sign-in follow it; stdio servers run on this device and are not affected.</string>
  <string name="network_shell_limits">Shell: TCP and UDP connections and DNS follow the route (shells opened before a change keep the old one until restarted). Ping and connections from your tailnet into the shell are not supported.</string>
  <string name="network_browser_no_proxy">This device\'s WebView cannot use a proxy, so the browser connects directly.</string>
