  <string name="network_diagnostics">Network Diagnostics</string>
  <string name="network_diagnostics_footer">Checks each step a connection takes and says where it fails. The result contains no passwords or keys.</string>
  <string name="network_diagnostics_running">Checking…</string>
  <string name="network_diagnostics_copy">Copy Result</string>
  <string name="network_copied">Copied</string>
  <string name="network_entry_note">Minis listens on 127.0.0.1 for its own connections. Other apps on this device can reach that port but cannot use it without a password that changes every time Minis starts.</string>
